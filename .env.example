# --- storage ---
DB_PATH=./data/gsnote.db

# --- LLM provider (BYOM via Pydantic AI) ---
# LLM_PROVIDER: openrouter | anthropic | <any OpenAI-compatible provider>
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
CLASSIFIER_MODEL=openai/gpt-4o-mini
ANSWER_MODEL=openai/gpt-4o

# Anthropic example (native or Anthropic-compatible gateway):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=                       # leave blank for api.anthropic.com, or set a gateway base
#   CLASSIFIER_MODEL=claude-haiku-4-5-20251001
#   ANSWER_MODEL=claude-sonnet-4-6

# --- embeddings (in-process, fastembed/ONNX) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# --- channel: telegram | none ---
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
# required when CHANNEL=telegram — comma-separated numeric Telegram user ids (empty refuses to start)
TELEGRAM_ALLOWED_USER_IDS=

# --- speech-to-text for voice notes (OpenAI-compatible endpoint) ---
STT_ENABLED=false
STT_BASE_URL=
STT_MODEL=whisper-large-v3-mlx
STT_API_KEY=

# --- proactive resurfacing ---
RESURFACING_ENABLED=true
RESURFACING_CRON=0 9 * * MON
RESURFACING_BUDGET=3
RESURFACING_THRESHOLD=0.6
RESURFACING_COOLDOWN_DAYS=30

# --- graph ---
SEMANTIC_KNN_K=5
SEMANTIC_SIMILARITY_THRESHOLD=0.75
TEMPORAL_PROXIMITY_HOURS=24
GRAPH_MIN_EDGE_WEIGHT=0.3

# --- retrieval ---
RETRIEVAL_CANDIDATE_N=20
RETRIEVAL_TOP_K=8
RRF_K=60

# --- backup (optional — leave LITESTREAM_ENABLED=false for OSS users without S3) ---
LITESTREAM_ENABLED=false
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
