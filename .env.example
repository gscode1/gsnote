# --- storage ---
DB_PATH=./data/gsnote.db

# --- LLM provider (BYOM via Pydantic AI) ---
# LLM_PROVIDER: openrouter | anthropic | <any OpenAI-compatible provider>
LLM_PROVIDER=openrouter
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
CLASSIFIER_MODEL=openai/gpt-4o-mini
ANSWER_MODEL=openai/gpt-4o

# Anthropic example (native or Anthropic-compatible gateway):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=                       # leave blank for api.anthropic.com, or set a gateway base
#   CLASSIFIER_MODEL=claude-haiku-4-5-20251001
#   ANSWER_MODEL=claude-sonnet-4-6

# --- embeddings ---
# EMBEDDING_PROVIDER: local (in-process fastembed/ONNX) | api (OpenAI-compatible endpoint)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# api examples — EMBEDDING_DIM must match the model, and changing it on a populated
# DB leaves stale vectors in note_vectors (FLOAT[dim]); re-embed before switching.
#   Ollama:  EMBEDDING_PROVIDER=api EMBEDDING_BASE_URL=http://localhost:11434/v1 EMBEDDING_MODEL=nomic-embed-text EMBEDDING_DIM=768
#   OpenAI:  EMBEDDING_PROVIDER=api EMBEDDING_BASE_URL=https://api.openai.com/v1 EMBEDDING_MODEL=text-embedding-3-small EMBEDDING_DIM=1536

# --- HTTP API auth ---
# Bearer token for /capture, /search, /report, /export. Empty = HTTP data API disabled
# (Telegram still works). Generate one: openssl rand -hex 32
API_TOKEN=

# --- channel: telegram | slack | none ---
CHANNEL=telegram
TELEGRAM_BOT_TOKEN=
# required when CHANNEL=telegram — comma-separated numeric Telegram user ids (empty refuses to start)
TELEGRAM_ALLOWED_USER_IDS=

# required when CHANNEL=slack — bot token (xoxb-) and app-level token (xapp-, Socket Mode).
# Slack app setup: Socket Mode on; bot scopes chat:write, im:history (+ files:read for voice);
# Event Subscriptions: message.im. Slash commands are typed as plain DM text ("/space work").
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# comma-separated Slack user ids (U...) — empty refuses to start
SLACK_ALLOWED_USER_IDS=

# --- speech-to-text for voice notes (OpenAI-compatible endpoint) ---
STT_ENABLED=false
STT_BASE_URL=
STT_MODEL=whisper-large-v3-mlx
STT_API_KEY=

# --- proactive resurfacing ---
RESURFACING_ENABLED=true
RESURFACING_CRON=0 9 * * MON
RESURFACING_BUDGET=3
RESURFACING_THRESHOLD=0.6
RESURFACING_COOLDOWN_DAYS=30

# --- graph ---
SEMANTIC_KNN_K=5
SEMANTIC_SIMILARITY_THRESHOLD=0.75
TEMPORAL_PROXIMITY_HOURS=24
GRAPH_MIN_EDGE_WEIGHT=0.3

# --- retrieval ---
RETRIEVAL_CANDIDATE_N=20
RETRIEVAL_TOP_K=8
RRF_K=60

# --- backup (optional — leave LITESTREAM_ENABLED=false for OSS users without S3) ---
LITESTREAM_ENABLED=false
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
