# --- storage ---
DB_PATH=./data/gsnote.db

# --- embeddings ---
# EMBEDDING_PROVIDER: local (in-process fastembed/ONNX) | api (OpenAI-compatible endpoint)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# api examples — EMBEDDING_DIM must match the model, and changing it on a populated
# DB is refused at startup; run `python -m app.reindex` (see README) to re-embed.
#   Ollama:  EMBEDDING_PROVIDER=api EMBEDDING_BASE_URL=http://localhost:11434/v1 EMBEDDING_MODEL=nomic-embed-text EMBEDDING_DIM=768
#   OpenAI:  EMBEDDING_PROVIDER=api EMBEDDING_BASE_URL=https://api.openai.com/v1 EMBEDDING_MODEL=text-embedding-3-small EMBEDDING_DIM=1536

# --- HTTP API auth ---
# Bearer token for /capture, /search, /spaces, /export, /import, /notes/{id}. Empty = data API disabled
# (fail closed). This is the only required secret. Generate one: openssl rand -hex 32
API_TOKEN=

# --- time ---
# IANA timezone: date-only since/until search filters mean whole days in this timezone
TIMEZONE=UTC

# --- retrieval ---
RETRIEVAL_CANDIDATE_N=50
RETRIEVAL_TOP_K=8
# Relevance gate (query searches): RETRIEVAL_GATE=false returns the top results unfiltered.
# RETRIEVAL_RELATIVE_GAP=0.2   # drop notes this far below the best match's cosine similarity (0 = off)
# RETRIEVAL_MIN_SIMILARITY=    # absolute cosine floor; unset = 0.45 for bge-*-en-v1.5, off otherwise
# EMBEDDING_QUERY_PREFIX=      # unset = auto (bge-*-en-v1.5 query instruction); empty = none
RRF_K=60

# --- backup (optional — leave LITESTREAM_ENABLED=false for OSS users without S3) ---
LITESTREAM_ENABLED=false
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
